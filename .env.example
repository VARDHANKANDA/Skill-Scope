# SkillScope Environment Configuration Example
# Copy this file to .env and configure the variables.

# Port for the API server (e.g. 5000)
PORT=5000

# Base path for client asset serving (default: /)
BASE_PATH=/

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://username:password@localhost:5432/skillscope

# Clerk Authentication Keys
# Publishable Key (used by frontend in artifacts/skillscope)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Publishable Key (used by backend in artifacts/api-server)
CLERK_PUBLISHABLE_KEY=pk_test_...

# Secret Key (used by backend in artifacts/api-server)
CLERK_SECRET_KEY=sk_test_...

# OpenAI API Key (used by backend for AI Career Coach)
OPENAI_API_KEY=sk-proj-...
